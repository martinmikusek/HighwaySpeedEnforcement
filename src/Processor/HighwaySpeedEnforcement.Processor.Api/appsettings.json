{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Processor": {
    "PartitionCount": 4,
    "IngestChannelCapacity": 10000,
    "CameraBoardWindow": "00:00:02",
    "GlobalBoardLinger": "00:00:03",
    "InactivityTimeout": "00:00:05",
    "FutureTimestampTolerance": "00:01:00",
    "IngestLagWarning": "00:00:05",
    "HeartbeatsEnabled": true
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 1883,
    "Topic": "highway/telemetry/v1",
    "ClientId": "speed-processor"
  }
}
