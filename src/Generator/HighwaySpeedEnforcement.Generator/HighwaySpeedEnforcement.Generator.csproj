<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The source-generated P/Invoke (LibraryImport) for SetConsoleMode in InteractiveConsole needs it; no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HighwaySpeedEnforcement.Generator.Domain/HighwaySpeedEnforcement.Generator.Domain.csproj" />
    <ProjectReference Include="../HighwaySpeedEnforcement.Generator.Infrastructure/HighwaySpeedEnforcement.Generator.Infrastructure.csproj" />
    <ProjectReference Include="../../Processor/HighwaySpeedEnforcement.Processor.Contracts/HighwaySpeedEnforcement.Processor.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
