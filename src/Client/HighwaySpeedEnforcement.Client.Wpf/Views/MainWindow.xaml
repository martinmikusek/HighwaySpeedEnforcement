<Window x:Class="HighwaySpeedEnforcement.Client.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Highway Speed Enforcement"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Width="1040" Height="660" MinWidth="900" MinHeight="480"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: logo, title, connection pill; a mint line underneath -->
    <StackPanel Grid.Row="0">
      <Border Style="{StaticResource HeaderBarStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Parody wordmark: our own text-only mark, not Yunex Traffic's logo -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource MintBrush}" CornerRadius="4" Padding="8,0" Height="30" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <RotateTransform Angle="-6" />
              </Border.RenderTransform>
              <TextBlock Text="NOT" FontFamily="Segoe UI Black" FontSize="19" Foreground="{StaticResource HeaderBrush}" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="YUNEX" FontFamily="Segoe UI Black" FontSize="27" Foreground="{StaticResource WhiteBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Rectangle Grid.Column="1" Width="1" Height="36" Fill="{StaticResource DarkSlateBrush}" Margin="18,0,18,0" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource AppTitleStyle}" Text="Highway Speed Enforcement" />
            <TextBlock Style="{StaticResource TaglineStyle}" Text="Live leaderboards from ten cameras. Any resemblance to a real traffic company is coincidental." />
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border Style="{StaticResource ConnectionPillStyle}" HorizontalAlignment="Right">
              <TextBlock Style="{StaticResource ConnectionPillTextStyle}" />
            </Border>
            <TextBlock Style="{StaticResource TaglineStyle}" Text="{Binding LastSuccessText}" HorizontalAlignment="Right" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <Rectangle Height="3" Fill="{StaticResource MintBrush}" />
    </StackPanel>

    <!-- Stale banner (BR-UI-03) -->
    <Border Grid.Row="1" Style="{StaticResource StaleBannerStyle}">
      <TextBlock Style="{StaticResource StaleBannerTextStyle}" Text="{Binding StatusText}" />
    </Border>

    <!-- Two boards side by side (BR-UI-01) -->
    <Grid Grid.Row="2" Margin="20,18,20,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Global leaderboard -->
      <Border Grid.Column="0" Style="{StaticResource CardStyle}" DataContext="{Binding Global}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CardTitleStyle}" Text="{Binding Title}" />
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource LiveDotStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding AgeText}" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource MutedTextStyle}" Text="{Binding LatestEventText}" Margin="0,4,0,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Style="{StaticResource DimmableStyle}">
            <ListView Style="{StaticResource BoardListStyle}" ItemsSource="{Binding Entries}">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                  <GridViewColumn Header="#" Width="48">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource RankBadgeStyle}">
                          <TextBlock Style="{StaticResource RankTextStyle}" Text="{Binding Rank}" />
                        </Border>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Number plate" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource PlateTextStyle}" Text="{Binding NumberPlate}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Average (km/h)" Width="100">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource NumberTextStyle}" Text="{Binding ScoreText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Measurements" Width="94">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource NumberTextStyle}" Text="{Binding DetailText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Latest at" Width="96">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource TimeTextStyle}" Text="{Binding TimeText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock Style="{StaticResource EmptyTextStyle}" Text="{Binding EmptyText}" />
          </Grid>
        </Grid>
      </Border>

      <!-- Camera leaderboard -->
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardHeaderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Camera" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource CameraComboBoxStyle}" ItemsSource="{Binding CameraOptions}" SelectedItem="{Binding SelectedCamera}" />
                <TextBlock Style="{StaticResource CardTitleStyle}" Text="leaderboard" Margin="8,0,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" DataContext="{Binding Camera}">
                <Ellipse Style="{StaticResource LiveDotStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding AgeText}" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource MutedTextStyle}" Text="{Binding Camera.LatestEventText}" Margin="0,4,0,0" />
            </Grid>
          </Border>

          <Grid Grid.Row="1" Style="{StaticResource DimmableStyle}" DataContext="{Binding Camera}">
            <ListView Style="{StaticResource BoardListStyle}" ItemsSource="{Binding Entries}">
              <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                  <GridViewColumn Header="#" Width="48">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource RankBadgeStyle}">
                          <TextBlock Style="{StaticResource RankTextStyle}" Text="{Binding Rank}" />
                        </Border>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Number plate" Width="130">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource PlateTextStyle}" Text="{Binding NumberPlate}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Speed (km/h)" Width="110">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource NumberTextStyle}" Text="{Binding ScoreText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Measured at" Width="100">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Style="{StaticResource TimeTextStyle}" Text="{Binding TimeText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <TextBlock Style="{StaticResource EmptyTextStyle}" Text="{Binding EmptyText}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Text="{Binding StatusText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding CanChangePollInterval, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Refresh every" />
          <ComboBox Style="{StaticResource CameraComboBoxStyle}" ItemsSource="{Binding PollIntervalOptions}" SelectedItem="{Binding SelectedPollInterval}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding TotalSeconds, StringFormat={}{0:0.##} s}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
