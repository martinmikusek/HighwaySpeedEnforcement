<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Processor/HighwaySpeedEnforcement.Processor.Contracts/HighwaySpeedEnforcement.Processor.Contracts.csproj" />
    <ProjectReference Include="../../src/Processor/HighwaySpeedEnforcement.Processor.Domain/HighwaySpeedEnforcement.Processor.Domain.csproj" />
    <ProjectReference Include="../../src/Processor/HighwaySpeedEnforcement.Processor.Application/HighwaySpeedEnforcement.Processor.Application.csproj" />
    <ProjectReference Include="../../src/Processor/HighwaySpeedEnforcement.Processor.Infrastructure/HighwaySpeedEnforcement.Processor.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Generator/HighwaySpeedEnforcement.Generator.Domain/HighwaySpeedEnforcement.Generator.Domain.csproj" />
    <ProjectReference Include="../../src/Generator/HighwaySpeedEnforcement.Generator.Infrastructure/HighwaySpeedEnforcement.Generator.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Generator/HighwaySpeedEnforcement.Generator/HighwaySpeedEnforcement.Generator.csproj" />
    <ProjectReference Include="../../src/Client/HighwaySpeedEnforcement.Client.Application/HighwaySpeedEnforcement.Client.Application.csproj" />
    <ProjectReference Include="../../src/Client/HighwaySpeedEnforcement.Client.Infrastructure/HighwaySpeedEnforcement.Client.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Client/HighwaySpeedEnforcement.Client.ViewModels/HighwaySpeedEnforcement.Client.ViewModels.csproj" />
  </ItemGroup>

  <!-- The approved example files of docs/contracts are the input of the contract tests (plan step 10). -->
  <ItemGroup>
    <Content Include="../../docs/contracts/examples/*.json" Link="Contracts/examples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
